---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { breadcrumbSchema, href } from '../../site';

const posts = (await getCollection('guides')).sort((a, b) => +b.data.published - +a.data.published);
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Guides', path: '/guides/' },
];
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  keywords={["format fec", "fichier des écritures comptables", "fec 18 champs", "anomalies fec", "contrôle fiscal fec", "fec bnc", "test compta démat", "guide fec"]}
  title="Guides FEC : format, anomalies et contrôle fiscal"
  description="Le format du FEC et ses 18 champs, les anomalies à corriger, le cas des BNC et BA en trésorerie, et la méthode pour vérifier son fichier avant un contrôle fiscal."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <Crumbs items={crumbs} />
  <section class="hero wrap narrow">
    <h1>Guides du FEC</h1>
    <p class="lead">
      Des explications concrètes sur le format et sur la réforme, écrites par un développeur qui a passé du temps dans les spécifications
      pour que vous n’ayez pas à le faire.
    </p>
  </section>
  <div class="wrap narrow">
    <ul class="post-list">
      {posts.map((p) => (
        <li class="card">
          <a href={href(`/guides/${p.id}/`)}>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <time datetime={p.data.published.toISOString()}>{fmt(p.data.published)}</time>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
