---
interface Props {
  focus?: 'synthese' | 'controles' | 'balance' | 'journaux' | 'ecritures';
  label?: string;
}
const { focus = 'synthese', label = 'Déposez votre FEC (Fichier des Écritures Comptables)' } = Astro.props;
---
<section class="fec-tool" data-fec-tool data-focus={focus} aria-label="Lecteur et validateur de FEC">
  <div class="drop" data-drop>
    <p class="big">{label}</p>
    <p>Fichier .txt ou .csv, du type <code>123456789FEC20251231.txt</code>. Glissez-déposez le fichier ici, ou</p>
    <div class="btn-row" style="justify-content:center">
      <label class="btn" style="margin:0;color:var(--accent-ink)">
        Choisir un fichier
        <input type="file" accept=".txt,.csv,.tsv,.dat,text/plain,text/csv" data-file />
      </label>
      <button type="button" class="btn secondary" data-sample>Essayer avec un exemple</button>
    </div>
    <p class="privacy">🔒 Analyse 100 % locale : votre comptabilité ne quitte pas votre ordinateur.</p>
  </div>
  <div class="result" data-result hidden aria-live="polite"></div>
</section>

<script>
  import { mountFecTool } from '../scripts/fec-ui';
  document.querySelectorAll<HTMLElement>('[data-fec-tool]').forEach(mountFecTool);
</script>
